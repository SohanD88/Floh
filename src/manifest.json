{
    "manifest_version": 3,
    "name": "Floh",
    "version": "0.1.0",
    "description": "Fast spelling corrections for text boxes.",
    "action": {
    "default_popup": "popup.html"
    },
    "permissions": [
    "storage"
    ],
    "host_permissions": [
        "https://floh-api-sohand88.fly.dev/*"
    ],
    "content_scripts": [
    {
        "matches": ["<all_urls>"],
        "js": ["content.js"],
        "all_frames": true,
        "match_about_blank": true
    }
    ],
    "background": {
    "service_worker": "background.js"
    }
}
